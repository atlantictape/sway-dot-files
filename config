# config vars #

# keybind vars
set $mod Mod4

# color vars
set $red #C42D2D
set $orange #EA9C29
set $green #6DBE60
set $blue #3881DA
set $inigo #502C96
set $purple #502C96

# app vars
set $terminal kitty
set $applancher "wofi --show drun"
set $wallpapers /home/lucas/.executables/SwaybgScript
set $envormentvars /home/lucas/.executables/sway-vars
set $browser firefox
# screenshot "comands"
set $screen-shot /home/lucas/.executables/grim-save
set $screen-copy /home/lucas/.executables/grim-copy

# settings #
# you know this
focus_follows_mouse yes

# it dosent focus on new windows i think
focus_on_window_activation none
# you cant drag tiles
tiling_drag disable

# dose not show the "open down or sideways"
# "mark"
show_marks no

# auto start #
exec $wallpaper
exec $envormentvars

#window bar stuffs config #
gaps inner 4
gaps outer 4
default_border pixel 3
titlebar_padding 1
titlebar_border_thickness 0
client.focused #454355 #6A679E #454355 $red #454355
client.unfocused #13121F #6A679E #13121F $red #13121F 

# Window Colours
# example:
#
# client.example <border around title> <backgorund around title>
# <text in title> <indicator(the marks)> <child/window border>

# keybinds #
bindsym $mod+q exec $terminal
bindsym $mod+r exec "wofi --show drun"
bindsym $mod+f exec $browser
bindsym $mod+c kill
bindsym $mod+g exec $screen-copy
bindsym $mod+Shift+g $screen-shot
bindsym $mod+v floating toggle

bindsym $mod+Shift+r reload
bindsym $mod+m exec swaynag -t warning -m 'YOU yes YOU will be loged out DO YOU REALLLYYY want to quit?!?!?

#split horazontile
bindsym $mod+h splith
#split sideways
bindsym $mod+s splitv

# windows and workspaces #
# tecncly keybinds but its special

# move to workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# move the container/window to workspaces
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# move between windows
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move windows between windows
bindsym $mod+Shift+left move left
bindsym $mod+Shift+down move down
bindsym $mod+Shift+up move up
bindsym $mod+Shift+right move right
# i dont use these layouts
# but to not lock myself out 
bindsym $mod+Shift+m layout stacking
bindsym $mod+Shift+l layout tabbed
bindsym $mod+Shift+p layout toggle split
